XRPL_NETWORK=xrpl:1
XRPL_TESTNET_WS=wss://s.altnet.rippletest.net:51233
XRPL_MAINNET_WS=wss://s1.ripple.com:51233
XRPL_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai

SELLER_PORT=8080
SELLER_BASE_URL=http://127.0.0.1:8080
XRPL_PAY_TO=
XRPL_PRICE_DROPS=500000

XRPL_BUYER_SEED=
BUYER_MAX_DROPS_PER_REQUEST=1000000
BUYER_MAX_DROPS_PER_SESSION=3000000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

DASHBOARD_PORT=8090

# Which ledger the analysis engine reads: mainnet (xrpscan indexer) or testnet
# (pools read straight off the ledger). Must agree with the payment network for
# recommendations to name pools the buyer's wallet can actually reach.
XRPL_ENGINE_NETWORK=mainnet

# Platform / marketplace tier
PLATFORM_PORT=8081
XRPL_PLATFORM_PAY_TO=
XRPL_MATCH_PRICE_DROPS=100000

# Execution is opt-in: the buyer validates plans either way, but only signs and
# submits allocation transactions when this is exactly "true".
BUYER_EXECUTE=false

# Marketplace pricing. Listing is a cheap paid call; allocation is the main fee.
XRPL_LIST_PRICE_DROPS=10000
XRPL_PRICE_DROPS=500000
# Basis points of every fee the platform keeps before paying strategy authors.
PLATFORM_CUT_BPS=2000
# Seed used by `npm run settle` to pay authors. Never needed by the server.
XRPL_PLATFORM_SEED=

# The xrpl-agent-wallet skill reads XRPL_SEED. Point it at the same wallet as
# XRPL_BUYER_SEED so the skill loads the funded account instead of making a new one.
XRPL_SEED=
